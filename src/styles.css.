:root {
font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, “Segoe UI”, sans-serif;
color: #f4f5ff;
background: #080914;
font-synthesis: none;
text-rendering: optimizeLegibility;
-webkit-font-smoothing: antialiased;
-moz-osx-font-smoothing: grayscale;
font-optical-sizing: auto;
font-weight: 400;
–bg: #080914;
–panel: #111323;
–panel-light: #171a30;
–border: rgba(174, 174, 255, 0.14);
–muted: #9699b5;
–purple: #a78bfa;
–blue: #66a6ff;
}

* {
    box-sizing: border-box;
    }

html {
min-width: 320px;
min-height: 100%;
background: var(–bg);
}

body {
margin: 0;
min-width: 320px;
min-height: 100vh;
background:
radial-gradient(ellipse at 75% 0%, rgba(83, 52, 172, 0.18), transparent 36rem),
radial-gradient(ellipse at 0% 45%, rgba(36, 86, 171, 0.10), transparent 30rem),
var(–bg);
}

button,
textarea,
select {
font: inherit;
}

button {
color: inherit;
}

button:focus-visible,
textarea:focus-visible,
select:focus-visible {
outline: 2px solid var(–purple);
outline-offset: 3px;
}

button:disabled {
opacity: 0.55;
cursor: not-allowed;
}

#root {
min-height: 100vh;
}

.app {
min-height: 100vh;
}

.topbar {
position: sticky;
top: 0;
z-index: 10;
min-height: 76px;
padding: 0 5%;
display: flex;
align-items: center;
justify-content: space-between;
gap: 20px;
background: rgba(8, 9, 20, 0.88);
border-bottom: 1px solid var(–border);
backdrop-filter: blur(18px);
}

.brand {
display: inline-flex;
align-items: center;
gap: 12px;
padding: 0;
background: transparent;
border: 0;
text-align: left;
cursor: pointer;
}

.brand-mark {
display: grid;
place-items: center;
width: 43px;
height: 43px;
border-radius: 14px;
background: linear-gradient(135deg, #a78bfa, #617bff 75%);
color: #fff;
font-size: 25px;
font-weight: 900;
box-shadow: 0 0 28px rgba(125, 92, 255, 0.28);
}

.brand strong,
.brand small {
display: block;
}

.brand strong {
font-size: 16px;
letter-spacing: 2px;
}

.brand small {
margin-top: 3px;
color: #a4a6c4;
font-size: 10px;
letter-spacing: 3px;
}

.status {
display: inline-flex;
align-items: center;
gap: 9px;
padding: 9px 13px;
color: #c5c6de;
background: rgba(255, 255, 255, 0.035);
border: 1px solid var(–border);
border-radius: 999px;
font-size: 12px;
}

.status-dot,
.mini-dot {
width: 7px;
height: 7px;
border-radius: 50%;
background: #66e3ad;
box-shadow: 0 0 12px rgba(102, 227, 173, 0.7);
}

.workspace {
display: grid;
grid-template-columns: 235px minmax(0, 1fr);
min-height: calc(100vh - 76px);
}

.sidebar {
position: sticky;
top: 76px;
align-self: start;
height: calc(100vh - 76px);
min-height: 500px;
padding: 30px 16px;
display: flex;
flex-direction: column;
border-right: 1px solid var(–border);
background: rgba(10, 11, 24, 0.45);
}

.nav-label {
padding: 0 13px;
margin: 0 0 16px;
color: #777b9d;
font-size: 10px;
font-weight: 800;
letter-spacing: 2px;
}

.nav-item {
display: flex;
align-items: center;
gap: 13px;
width: 100%;
padding: 13px;
margin-bottom: 5px;
border: 1px solid transparent;
border-radius: 12px;
color: #a8aac5;
background: transparent;
text-align: left;
cursor: pointer;
transition: 180ms ease;
}

.nav-item:hover {
color: #fff;
background: rgba(255, 255, 255, 0.045);
}

.nav-item.active {
color: #fff;
border-color: rgba(167, 139, 250, 0.18);
background: linear-gradient(100deg, rgba(139, 92, 246, 0.2), rgba(92, 116, 255, 0.07));
}

.nav-symbol {
display: inline-grid;
place-items: center;
width: 23px;
font-size: 20px;
color: #b5a0ff;
}

.sidebar-note {
margin-top: auto;
padding: 17px;
border: 1px solid var(–border);
border-radius: 16px;
background: linear-gradient(145deg, rgba(143, 103, 255, 0.12), rgba(69, 103, 207, 0.04));
}

.note-icon {
display: block;
margin-bottom: 12px;
color: #c1a7ff;
font-size: 22px;
}

.sidebar-note strong {
font-size: 13px;
}

.sidebar-note p {
margin: 8px 0 0;
color: var(–muted);
font-size: 12px;
line-height: 1.7;
}

.content {
min-width: 0;
width: 100%;
max-width: 1500px;
margin: 0 auto;
padding: 34px clamp(20px, 4vw, 62px) 20px;
}

.eyebrow {
margin-bottom: 25px;
color: #a9abc8;
font-size: 10px;
font-weight: 800;
letter-spacing: 2px;
}

.eyebrow span {
margin: 0 8px;
color: #6f71a0;
}

.hero {
position: relative;
display: grid;
grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
align-items: center;
gap: 25px;
min-height: 365px;
padding: clamp(24px, 4vw, 50px);
overflow: hidden;
border: 1px solid var(–border);
border-radius: 25px;
background:
radial-gradient(ellipse at 85% 45%, rgba(111, 80, 255, 0.2), transparent 50%),
linear-gradient(130deg, rgba(24, 25, 48, 0.96), rgba(12, 14, 29, 0.95));
}

.hero-copy {
position: relative;
z-index: 2;
}

.tag {
display: inline-flex;
align-items: center;
gap: 8px;
padding: 9px 12px;
border: 1px solid rgba(167, 139, 250, 0.22);
border-radius: 999px;
color: #c4b5fd;
background: rgba(167, 139, 250, 0.08);
font-size: 10px;
font-weight: 800;
letter-spacing: 1px;
}

.tag span {
font-size: 14px;
}

.hero h1,
.creator-panel h1,
.empty-panel h1 {
margin: 24px 0 17px;
font-size: clamp(32px, 4vw, 53px);
line-height: 1.12;
letter-spacing: -1.8px;
}

.hero h1 span {
color: #b5a0ff;
background: linear-gradient(90deg, #c4b5fd, #76a9ff);
-webkit-background-clip: text;
background-clip: text;
-webkit-text-fill-color: transparent;
}

.hero-copy > p,
.panel-description {
max-width: 570px;
color: #a7aac5;
font-size: 14px;
line-height: 1.9;
}

.primary-button,
.secondary-button {
display: inline-flex;
align-items: center;
justify-content: center;
gap: 18px;
min-height: 48px;
padding: 0 20px;
border: 1px solid transparent;
border-radius: 12px;
font-weight: 750;
font-size: 13px;
cursor: pointer;
transition: transform 180ms ease, filter 180ms ease;
}

.primary-button {
margin-top: 17px;
color: #fff;
background: linear-gradient(105deg, #8b5cf6, #537cf5);
box-shadow: 0 9px 30px rgba(105, 83, 239, 0.22);
}

.primary-button:hover,
.secondary-button:hover {
transform: translateY(-2px);
filter: brightness(1.1);
}

.hero-art {
position: relative;
min-height: 270px;
display: grid;
place-items: center;
}

.orbit {
position: absolute;
width: min(270px, 95%);
aspect-ratio: 1;
border: 1px solid rgba(168, 145, 255, 0.22);
border-radius: 50%;
transform: rotate(-24deg) scaleY(0.7);
}

.orbit-one {
box-shadow: 0 0 55px rgba(126, 87, 255, 0.09);
}

.orbit-two {
width: min(210px, 75%);
transform: rotate(55deg) scaleY(0.85);
border-color: rgba(100, 166, 255, 0.28);
}

.art-core {
position: relative;
z-index: 1;
display: grid;
place-items: center;
width: 112px;
height: 112px;
border: 1px solid rgba(255, 255, 255, 0.22);
border-radius: 32px;
background: linear-gradient(140deg, rgba(166, 133, 255, 0.75), rgba(69, 103, 255, 0.48));
box-shadow: 0 0 70px rgba(120, 90, 255, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.3);
transform: rotate(-10deg);
}

.art-core span {
color: #fff;
font-size: 61px;
text-shadow: 0 0 22px rgba(255, 255, 255, 0.65);
}

.floating-card {
position: absolute;
z-index: 2;
display: flex;
align-items: center;
gap: 10px;
padding: 12px 14px;
border: 1px solid rgba(191, 181, 255, 0.2);
border-radius: 13px;
background: rgba(18, 19, 40, 0.85);
box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
color: #dedcf5;
font-size: 11px;
backdrop-filter: blur(15px);
}

.card-top {
top: 15%;
right: -2%;
}

.card-bottom {
bottom: 12%;
left: -3%;
}

.sparkle {
color: #c4b5fd;
font-size: 24px;
}

.card-bottom strong,
.card-bottom small {
display: block;
}

.card-bottom strong {
font-size: 10px;
letter-spacing: 1px;
}

.card-bottom small {
margin-top: 4px;
color: var(–muted);
font-size: 10px;
}

.section-heading {
display: flex;
align-items: center;
justify-content: space-between;
gap: 15px;
margin: 38px 0 18px;
}

.section-heading h2 {
margin: 0;
font-size: 22px;
letter-spacing: -0.5px;
}

.section-heading p {
margin: 7px 0 0;
color: var(–muted);
font-size: 13px;
}

.tool-grid {
display: grid;
grid-template-columns: repeat(3, minmax(0, 1fr));
gap: 16px;
}

.tool-card {
position: relative;
min-width: 0;
min-height: 190px;
padding: 21px;
border: 1px solid var(–border);
border-radius: 17px;
background: linear-gradient(145deg, rgba(22, 24, 45, 0.92), rgba(14, 15, 30, 0.92));
text-align: left;
cursor: pointer;
transition: 180ms ease;
}

.tool-card:hover {
transform: translateY(-4px);
border-color: rgba(167, 139, 250, 0.42);
background: linear-gradient(145deg, rgba(34, 29, 65, 0.95), rgba(14, 15, 30, 0.95));
}

.tool-icon {
display: grid;
place-items: center;
width: 43px;
height: 43px;
margin-bottom: 21px;
border-radius: 13px;
font-size: 20px;
}

.tool-icon.purple {
color: #c4b5fd;
background: rgba(139, 92, 246, 0.17);
}

.tool-icon.pink {
color: #f0abfc;
background: rgba(217, 70, 239, 0.13);
}

.tool-icon.blue {
color: #93c5fd;
background: rgba(59, 130, 246, 0.15);
}

.tool-card strong {
display: block;
margin-bottom: 9px;
font-size: 14px;
}

.tool-card p {
max-width: 250px;
margin: 0;
color: var(–muted);
font-size: 12px;
line-height: 1.7;
}

.tool-arrow {
position: absolute;
top: 23px;
right: 21px;
color: #8588b2;
font-size: 18px;
}

.creator-panel,
.empty-panel {
max-width: 850px;
margin: 25px auto 55px;
padding: clamp(24px, 5vw, 48px);
border: 1px solid var(–border);
border-radius: 23px;
background: linear-gradient(145deg, rgba(21, 23, 44, 0.95), rgba(12, 13, 27, 0.96));
}

.creator-panel h1,
.empty-panel h1 {
font-size: clamp(30px, 4vw, 44px);
}

.panel-description {
margin-bottom: 30px;
}

.field-label {
display: block;
margin: 22px 0 10px;
color: #e2e2f3;
font-size: 12px;
font-weight: 750;
}

.creator-panel textarea,
.creator-panel select {
display: block;
width: 100%;
color: #f4f5ff;
border: 1px solid rgba(174, 174, 255, 0.2);
border-radius: 12px;
background: #0b0d1b;
}

.creator-panel textarea {
min-height: 140px;
padding: 15px;
resize: vertical;
line-height: 1.7;
}

.creator-panel textarea::placeholder {
color: #686c8c;
}

.creator-panel select {
min-height: 48px;
padding: 0 13px;
}

.create-button {
width: 100%;
margin-top: 26px;
}

.notice {
padding: 14px;
border: 1px solid rgba(102, 227, 173, 0.22);
border-radius: 12px;
color: #a6f4d0;
background: rgba(102, 227, 173, 0.07);
font-size: 13px;
line-height: 1.7;
}

.helper {
color: #777b9d;
font-size: 11px;
line-height: 1.7;
}

.empty-panel {
text-align: center;
padding-top: 65px;
padding-bottom: 65px;
}

.empty-icon {
color: #c4b5fd;
font-size: 43px;
}

.empty-panel p {
color: var(–muted);
line-height: 1.8;
}

.secondary-button {
margin-top: 18px;
border-color: var(–border);
background: rgba(255, 255, 255, 0.04);
}

.footer {
display: flex;
justify-content: space-between;
gap: 15px;
margin-top: 55px;
padding: 20px 0 10px;
border-top: 1px solid var(–border);
color: #777b9d;
font-size: 9px;
letter-spacing: 1px;
}

@media (max-width: 1050px) {
.workspace {
grid-template-columns: 195px minmax(0, 1fr);
}

.hero {
grid-template-columns: minmax(0, 1fr) minmax(190px, 0.7fr);
}

.tool-grid {
gap: 12px;
}

.tool-card {
padding: 17px;
}
}

@media (max-width: 760px) {
.topbar {
min-height: 68px;
padding: 0 18px;
}

.status {
padding: 8px 10px;
font-size: 10px;
}

.workspace {
display: block;
}

.sidebar {
position: static;
width: 100%;
height: auto;
min-height: 0;
padding: 10px 14px;
border-right: 0;
border-bottom: 1px solid var(–border);
overflow-x: auto;
}

.nav-label,
.sidebar-note {
display: none;
}

.sidebar {
flex-direction: row;
gap: 6px;
}

.nav-item {
flex: 0 0 auto;
width: auto;
padding: 10px 12px;
margin: 0;
gap: 7px;
font-size: 12px;
}

.nav-symbol {
width: auto;
font-size: 16px;
}

.content {
padding: 25px 17px 18px;
}

.eyebrow {
margin-bottom: 18px;
font-size: 9px;
}

.hero {
grid-template-columns: 1fr;
gap: 0;
padding: 25px 22px;
}

.hero h1 {
font-size: clamp(32px, 8vw, 43px);
}

.hero-art {
min-height: 235px;
margin-top: 10px;
}

.card-top {
right: 0;
}

.card-bottom {
left: 0;
}

.tool-grid {
grid-template-columns: 1fr;
}

.tool-card {
min-height: 145px;
}

.tool-icon {
margin-bottom: 14px;
}

.footer {
flex-direction: column;
line-height: 1.8;
}
}

@media (max-width: 390px) {
.brand strong {
font-size: 13px;
letter-spacing: 1.4px;
}

.brand small {
font-size: 8px;
letter-spacing: 2px;
}

.brand-mark {
width: 38px;
height: 38px;
}

.status {
gap: 6px;
font-size: 9px;
}

.nav-item {
padding: 9px 10px;
}

.nav-symbol {
display: none;
}

.hero {
padding: 22px 17px;
}
}