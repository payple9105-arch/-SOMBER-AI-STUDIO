# Copia este archivo como variables de entorno en Render (o tu host).
# Nunca subas claves reales al repositorio.

# Generación de vídeo, imagen anime e imagen a vídeo (fal.ai)
FAL_KEY=fal_xxxxxxxxxxxxxxxx

# Créditos comprobados en el servidor (Supabase → Project Settings → API Keys → secret)
# Sin esta clave, generar responde 503.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Asistente de chat y "Mejorar con IA" (Claude, console.anthropic.com)
# Sin esta clave, "Mejorar con IA" usa un mejorador local y el chat avisa que falta.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# LLM_MODEL=claude-haiku-5-5

# Opcional: cambiar modelos de fal.ai
# FAL_VIDEO_MODEL=fal-ai/pixverse/v5.5/text-to-video
# FAL_I2V_MODEL=fal-ai/pixverse/v5.5/image-to-video
# FAL_IMAGE_MODEL=fal-ai/flux/schnell

# Opcional: restringir orígenes cuando dejes de usar "*"
# CORS_ORIGINS=https://payple9105-arch.github.io,https://tu-dominio.com
# RATE_LIMIT_PER_HOUR=20
# CHAT_RATE_LIMIT_PER_HOUR=60
